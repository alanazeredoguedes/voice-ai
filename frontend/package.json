{
  "name": "voice-ai",
  "version": "1.0.12",
  "description": "Voice AI Desktop App",
  "main": "./out/main/index.js",
  "author": {
    "name": "Alan Guedes",
    "email": "alan.guedes@monuv.com.br"
  },
  "homepage": ".",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dev": "electron-vite dev -- --no-sandbox",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "electron-vite build && electron-builder --mac",
    "release": "node scripts/release.mjs",
    "build:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "axios": "^1.7.9",
    "pinia": "^2.2.8",
    "vue": "^3.5.13",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "autoprefixer": "^10.4.20",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
